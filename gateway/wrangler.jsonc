{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bourse-facile-market",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "MARKET", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "UPSTREAM_URL": "https://YOUR_API_HOST/api/market/daily-quotes"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
